# Arc Relay Bridge — environment variables
#
# Copy this file to .env and fill in real values for local script usage.
# .env is gitignored and must NEVER be committed.
#
# In production (Replit), all of these are set as Replit Secrets,
# not as a .env file. Do not store real values here.

# Private key of the deployer / relayer wallet (0x-prefixed, 64 hex chars).
# Used by: scripts/src/deploy*.ts, scripts/src/fund*.ts, artifacts/api-server relay route.
# KEEP THIS SECRET — exposure gives full control of the deployer wallet.
DEPLOYER_PRIVATE_KEY=0x<your-deployer-private-key>

# Address that receives protocol fees collected by FeeRouter and GasRelayer contracts.
FEE_RECIPIENT=0x<fee-recipient-address>

# Pimlico API key for ERC-4337 bundler access (https://dashboard.pimlico.io).
PIMLICO_API_KEY=<your-pimlico-api-key>

# Secret used to sign/verify Express sessions (any long random string).
SESSION_SECRET=<random-secret-at-least-32-chars>
